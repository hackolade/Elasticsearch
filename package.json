{
    "name": "Elasticsearch",
    "version": "0.2.7",
    "author": "hackolade",
    "engines": {
        "hackolade": "1.12.7",
        "hackoladePlugin": "1.0.0"
    },
    "contributes": {
        "target": {
            "applicationTarget": "ELASTICSEARCH",
            "title": "Elasticsearch",
            "versions": [
                "2.x",
                "5.x",
                "6.x"
            ]
        },
        "features": {
            "disableMultipleTypes": true,
            "enableReverseEngineering": true,
            "enableForwardEngineering": true,
            "enableReverseEngineeringDetectionSchemaByContent": true,
            "restrictNestedFieldsAsPrimaryKey": false
        }
    },
    "description": "Hackolade plugin for Elasticsearch 2.0 thru 6.8.  For version 7.0 and above requires a new plugin!",
    "dependencies": {
        "async": "2.6.4",
        "elasticsearch": "16.1.1",
        "lodash": "4.18.1"
    },
    "simple-git-hooks": {
        "pre-commit": "npm run package && npx lint-staged --config lint-staged.config.js",
        "pre-push": "npm run lint"
    },
    "scripts": {
        "lint": "oxlint . || true",
        "package": "node esbuild.package.js",
        "postinstall": "npx simple-git-hooks",
        "lint:check": "oxlint --type-aware --type-check . || true",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@hackolade/hck-esbuild-plugins-pack": "0.0.1",
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "esbuild": "0.28.1",
        "esbuild-node-externals": "1.23.1",
        "esbuild-plugin-clean": "1.0.1",
        "esbuild-plugin-copy": "2.1.1",
        "lint-staged": "17.0.7",
        "oxlint": "1.70.0",
        "oxlint-tsgolint": "0.23.0",
        "prettier": "3.8.4",
        "simple-git-hooks": "2.13.1"
    },
    "overrides": {
        "minimatch": "10.2.4"
    }
}
